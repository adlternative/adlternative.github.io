---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Group by category (top-level folder of the slug, e.g. "git/store" -> "git").
// Astro strips "+" from slugs, so "c++" becomes "c" — map it back for display.
const displayName: Record<string, string> = { c: "c++" };
const groups: Record<string, typeof posts> = {};
for (const post of posts) {
  const category = post.slug.includes("/")
    ? post.slug.split("/")[0]
    : "misc";
  (groups[category] ??= []).push(post);
}
const categories = Object.keys(groups).sort();

function fmt(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<Base current="Blog" title="Blog">
  <h1>Blog</h1>
  <p class="post-meta">{posts.length} posts</p>
  {
    categories.map((cat) => (
      <section>
        <h2 class="category-heading">{displayName[cat] ?? cat}</h2>
        <ul class="post-list">
          {groups[cat].map((post) => (
            <li class="post-item">
              <a href={`/blog/${post.slug}`}>
                <div class="post-title">{post.data.title}</div>
                <div class="post-meta">
                  <span>{fmt(post.data.date)}</span>
                  {" "}
                  {post.data.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
