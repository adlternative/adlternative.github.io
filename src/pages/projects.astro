---
import Base from "../layouts/Base.astro";

const projects = [
  {
    title: "pi-in-chrome",
    description:
      "Unrestricted Chrome automation for Pi, reverse-engineered from Claude Code's built-in extension with REA. Full CDP control, accessibility refs, and Pi's own model answering semantic element search — no login, cloud URL checks or popups.",
    link: "https://github.com/adlternative/pi-in-chrome",
  },
  {
    title: "pi-project-memory",
    description:
      "Project-scoped Markdown memory for Pi: a MEMORY.md index plus one file per note, git-common-dir identity so worktrees share a store, local BM25 recall, and opt-in background extraction.",
    link: "https://github.com/adlternative/pi-project-memory",
  },
  {
    title: "git",
    image: "/images/git.svg",
    description:
      "Git is a free and open source distributed version control system designed to handle everything from small to very large projects with speed and efficiency. It is written for Linux in C.",
    link: "https://github.com/adlternative/git/tree/cat-file-reuse-ref-filter-logic",
  },
  {
    title: "agent-historian",
    description:
      "A local CLI (ochist) for querying AI agent transcript history. It treats session logs as a REPL data source instead of relying on lossy memory layers or RAG embedding search.",
    link: "https://github.com/adlternative/agent-historian",
  },
];
---

<Base current="Projects" title="Projects">
  <h1>Projects</h1>
  {
    projects.map((p) => (
      <div class="post-item">
        <div class="post-title">{p.title}</div>
        <p>{p.description}</p>
        <a href={p.link} target="_blank" class="button">
          Check out the source code &rarr;
        </a>
      </div>
    ))
  }
</Base>
