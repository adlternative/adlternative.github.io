---
import Base from "../../layouts/Base.astro";
import type { CollectionEntry } from "astro:content";
import { getPosts, fmtDateTime } from "../../utils/posts";
import "../../styles/terminal-cta.css";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"blog"> };
const { post } = Astro.props;
const { Content } = await post.render();
const firstTag = post.data.tags?.[0] ?? "";
const ctaCmd = firstTag ? `ls posts --tag ${firstTag}` : "ls posts";
const hasBilingual = Boolean(post.data.titleZh);
---

<Base current="Blog" title={post.data.title} description={post.data.title}>
  <a href="/blog" class="back-link button">&larr; back to blog</a>
  <article>
    <div class="article-header">
      <h1
        id="post-title"
        data-title-en={post.data.title}
        data-title-zh={post.data.titleZh}
      >
        {post.data.title}
      </h1>
      <div class="post-meta">
        <span>{fmtDateTime(post.data.date)}</span>
        {" "}
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        {" "}
        <span class="views" id="post-views" hidden>
          &middot; <span id="post-views-count">&hellip;</span> views
        </span>
      </div>
      {
        hasBilingual && (
          <div class="lang-switcher" role="group" aria-label="Language switcher">
            <button
              type="button"
              class="button lang-btn selected"
              data-lang="en"
              aria-pressed="true"
            >
              English
            </button>
            <button
              type="button"
              class="button lang-btn"
              data-lang="zh"
              aria-pressed="false"
            >
              中文
            </button>
          </div>
        )
      }
    </div>
    <div class="prose">
      <Content />
    </div>
    <!-- Terminal inline CTA -->
    <div class="term-cta desktop-only" data-launch-cmd={ctaCmd}>
      <span class="term-cta-prompt">$</span>
      <span class="term-cta-cmd">{ctaCmd}</span>
      <span class="term-cta-hint">&larr; explore more in terminal</span>
    </div>
  </article>
</Base>

<style>
  .lang-switcher {
    margin-top: 1em;
    display: inline-flex;
    gap: 0.5em;
  }
  .lang-btn {
    cursor: pointer;
  }
  .lang-btn.selected {
    color: var(--bg);
    background-color: var(--fg);
    border-bottom: 1px dashed var(--fg);
  }
  @media (max-width: 640px) {
    .desktop-only {
      display: none !important;
    }
  }
</style>

<script>
  // Terminal CTA
  const cta = document.querySelector<HTMLElement>("[data-launch-cmd]");
  if (cta) {
    cta.addEventListener("click", () => {
      const cmd = cta.getAttribute("data-launch-cmd") ?? "";
      const getApi = (window as any).__termGetApi;
      if (getApi) getApi().then((api: any) => api.openWith(cmd));
    });
  }

  // Bilingual language switcher
  (function initLangSwitcher() {
    const titleEl = document.getElementById("post-title") as HTMLElement | null;
    const buttons = document.querySelectorAll<HTMLButtonElement>(".lang-btn");
    const sections = document.querySelectorAll<HTMLElement>(".lang-section");
    if (buttons.length === 0) return;

    const STORAGE_KEY = "adl-blog-lang";

    function applyLang(lang: "en" | "zh") {
      // Update title
      if (titleEl) {
        const newTitle = titleEl.getAttribute(`data-title-${lang}`);
        if (newTitle) titleEl.textContent = newTitle;
      }
      // Update sections
      sections.forEach((section) => {
        section.hidden = section.getAttribute("data-lang") !== lang;
      });
      // Update buttons
      buttons.forEach((btn) => {
        const active = btn.getAttribute("data-lang") === lang;
        btn.classList.toggle("selected", active);
        btn.setAttribute("aria-pressed", String(active));
      });
      // Update document title
      const pageTitle = titleEl?.getAttribute(`data-title-${lang}`);
      if (pageTitle) {
        document.title = `${pageTitle} - ZheNing Hu`;
      }
      try {
        localStorage.setItem(STORAGE_KEY, lang);
      } catch {}
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const lang = btn.getAttribute("data-lang") as "en" | "zh";
        applyLang(lang);
      });
    });

    // Restore preference, default to English
    let preferred: "en" | "zh" = "en";
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored === "en" || stored === "zh") preferred = stored;
    } catch {}
    applyLang(preferred);
  })();

  // Fetch and display view count from GoatCounter
  (function initViewCount() {
    const wrap = document.getElementById("post-views");
    const countEl = document.getElementById("post-views-count");
    if (!wrap || !countEl) return;

    const path = location.pathname;
    const url = `https://adlternative.goatcounter.com/counter/${encodeURIComponent(path)}.json`;

    fetch(url)
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((data: { count?: string }) => {
        if (data && data.count) {
          countEl.textContent = data.count.replace(/\s/g, "");
          wrap.hidden = false;
        }
      })
      .catch(() => {
        // API disabled or path not yet counted; keep hidden
      });
  })();
</script>
