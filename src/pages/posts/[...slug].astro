---
import Base from "../../layouts/Base.astro";
import type { CollectionEntry } from "astro:content";
import { getPosts, fmtDateTime } from "../../utils/posts";
import "../../styles/terminal-cta.css";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"blog"> };
const { post } = Astro.props;
const { Content } = await post.render();
const firstTag = post.data.tags?.[0] ?? "";
const ctaCmd = firstTag ? `ls posts --tag ${firstTag}` : "ls posts";
---

<Base current="Blog" title={post.data.title} description={post.data.title}>
  <a href="/blog" class="back-link button">&larr; back to blog</a>
  <article>
    <div class="article-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <span>{fmtDateTime(post.data.date)}</span>
        {" "}
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </div>
    <div class="prose">
      <Content />
    </div>
    <!-- Terminal inline CTA -->
    <div class="term-cta desktop-only" data-launch-cmd={ctaCmd}>
      <span class="term-cta-prompt">$</span>
      <span class="term-cta-cmd">{ctaCmd}</span>
      <span class="term-cta-hint">&larr; explore more in terminal</span>
    </div>
  </article>
</Base>

<style>
  @media (max-width: 640px) {
    .desktop-only {
      display: none !important;
    }
  }
</style>

<script>
  const cta = document.querySelector<HTMLElement>("[data-launch-cmd]");
  if (cta) {
    cta.addEventListener("click", () => {
      const cmd = cta.getAttribute("data-launch-cmd") ?? "";
      const getApi = (window as any).__termGetApi;
      if (getApi) getApi().then((api: any) => api.openWith(cmd));
    });
  }
</script>
