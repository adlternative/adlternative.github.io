---
import Base from "../layouts/Base.astro";
import AgentHero from "../components/AgentHero.astro";
// import TerminalHero from "../components/TerminalHero.astro";  // swapped out for AgentHero (revert anytime)

const asciiart = `44      4444    44
4444    44 44   44
44  44  44  44  44
444444  44  44  44
44  44  44 44   44
44  44  4444    444444`;

const paragraphs = [
  "I am a ghost hovering above the internet without a soul.",
  "I am adlternative. I died yesterday.",
  "I am adlternative. I died today.",
];
---

<Base current="Home">
  <!-- Day/night AI agent hero — sleeps by day, works by night -->
  <AgentHero />

  <!-- Mobile fallback + scroll-down content -->
  <div class="home-center mobile-only">
    <pre class="adl-text">{asciiart}</pre>
    <div class="subtitle">Software Developer</div>
    {paragraphs.map((p) => <p class="typetarget">{p}</p>)}
    <br />
    <a href="/about" class="button">Learn more!</a>
  </div>
</Base>

<style>
  /* Show original hero only on mobile */
  .mobile-only {
    display: none;
  }
  @media (max-width: 640px) {
    .mobile-only {
      display: block;
    }
  }
</style>

<script>
  // Typewriter effect for mobile fallback, ported from the original script.js
  function animateTyping(objects: NodeListOf<HTMLElement>) {
    if (objects.length <= 0) return;
    const typeobjects = Array.from(objects).map((o) => ({
      object: o,
      text: o.innerText,
    }));
    typeobjects.forEach((t) => (t.object.innerText = ""));
    type(typeobjects);
  }

  function type(typeobjects: { object: HTMLElement; text: string }[]) {
    let i = 0;
    const interval = setInterval(() => {
      const t = typeobjects[0];
      t.object.innerText = t.text.substring(0, ++i);
      t.object.innerHTML += '<span id="cursor"></span>';
      if (i >= t.text.length) {
        clearInterval(interval);
        if (typeobjects.length > 1) {
          t.object.innerText = t.text;
          typeobjects.splice(0, 1);
          type(typeobjects);
        }
      }
    }, 25);
  }

  document.addEventListener("DOMContentLoaded", () => {
    animateTyping(document.querySelectorAll<HTMLElement>(".typetarget"));
  });
</script>
