---
/**
 * Pseudo-terminal overlay — tmux-style 4-pane layout on desktop,
 * single-pane full-screen with mobile FAB + quick-actions on portrait phones.
 * - Rendered on every page (via Base.astro)
 * - Hidden by default, opens on ⌘K / Ctrl+K / backtick / launcher click
 * - Mobile portrait: only the shell pane renders, plus a quick-action strip
 *   and an explicit close button (Esc isn't available on touch keyboards).
 */
import "../styles/terminal.css";
---

<div
  id="term"
  class="term-overlay t-hidden"
  role="dialog"
  aria-modal="true"
  aria-label="adl.sh interactive terminal"
  aria-hidden="true"
>
  <div class="t-grid">
    <!-- pane[3]: sidebar tree (left 18%, hidden on mobile) -->
    <div class="t-pane t-pane-sidebar" data-pane="3">
      <div class="t-pane-titlebar"><span class="t-pane-idx">[3]</span> :tree</div>
      <div class="t-pane-body t-tree-container"></div>
    </div>

    <!-- pane[0]: main shell (center 52%) — only pane shown on mobile -->
    <div class="t-pane t-pane-shell" data-pane="0">
      <div class="t-pane-titlebar">
        <span class="t-pane-idx">[0]</span> $ shell
        <button
          type="button"
          class="t-close-btn"
          id="term-close"
          aria-label="Close terminal"
        >[<span class="t-close-x">&times;</span>&nbsp;close]</button>
      </div>
      <div class="t-pane-body t-shell-body">
        <div class="t-screen" role="log" aria-live="polite"></div>
        <div class="t-quick-actions" role="toolbar" aria-label="Quick commands">
          <button type="button" class="t-qa" data-cmd="help">help</button>
          <button type="button" class="t-qa" data-cmd="ls posts">ls&nbsp;posts</button>
          <button type="button" class="t-qa" data-cmd="whoami">whoami</button>
          <button type="button" class="t-qa" data-cmd="about">about</button>
          <button type="button" class="t-qa" data-cmd="clear">clear</button>
        </div>
        <div class="t-promptline">
          <span class="t-prompt"></span>
          <input
            type="text"
            class="t-input"
            inputmode="text"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            aria-label="Terminal input"
            placeholder="type `help` and press Enter"
          />
        </div>
      </div>
    </div>

    <!-- pane[1]: help/manual (right 30%) -->
    <div class="t-pane t-pane-help" data-pane="1">
      <div class="t-pane-titlebar"><span class="t-pane-idx">[1]</span> :help</div>
      <div class="t-pane-body t-help-container"></div>
    </div>

    <!-- pane[2]: preview (bottom full-width 35%) -->
    <div class="t-pane t-pane-preview" data-pane="2">
      <div class="t-pane-titlebar"><span class="t-pane-idx">[2]</span> :preview</div>
      <div class="t-pane-body t-preview-container"></div>
    </div>

    <!-- status bar (bottom 28px) -->
    <div class="t-pane-statusbar" data-statusbar></div>
  </div>
</div>

<button
  type="button"
  class="t-launcher"
  id="term-launcher"
  aria-label="Open adl.sh terminal (⌘K)"
  aria-controls="term"
>
  <span class="t-launcher-dots" aria-hidden="true">
    <span class="t-launcher-dot r"></span>
    <span class="t-launcher-dot y"></span>
    <span class="t-launcher-dot g"></span>
  </span>
  <span class="t-launcher-label"><span class="t-launcher-prompt">_$</span> adl.sh</span>
  <kbd class="t-launcher-kbd" aria-hidden="true">⌘K</kbd>
</button>

<script>
  // Boot on any device that can plausibly use the terminal:
  // - desktop (pointer:fine) for the full 4-pane experience
  // - mobile/tablet (no fine pointer) for the single-pane portrait mode
  // The CSS handles the layout split; JS only needs to gate on the
  // existence of matchMedia (i.e. real browser, not crawlers).
  const canBoot =
    typeof window !== "undefined" && typeof window.matchMedia === "function";

  const root = document.getElementById("term") as HTMLElement | null;
  const launcher = document.getElementById(
    "term-launcher",
  ) as HTMLButtonElement | null;
  const closeBtn = document.getElementById(
    "term-close",
  ) as HTMLButtonElement | null;

  if (!canBoot) {
    if (root) root.remove();
    if (launcher) launcher.remove();
  } else {
    type Api = {
      open: () => void;
      close: () => void;
      toggle: () => void;
      isOpen: () => boolean;
      openWith: (cmd: string) => void;
    };
    let apiPromise: Promise<Api> | null = null;
    function getApi(): Promise<Api> {
      if (!apiPromise) {
        apiPromise = import("../scripts/term").then(({ bootTerminal }) =>
          bootTerminal(root as HTMLElement),
        );
      }
      return apiPromise;
    }

    // Expose getApi globally for hero/header/CTA entry points
    (window as any).__termGetApi = getApi;

    if (launcher) {
      launcher.addEventListener("click", (e) => {
        e.preventDefault();
        getApi().then((api) => api.open());
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener("click", (e) => {
        e.preventDefault();
        getApi().then((api) => api.close());
      });
    }

    // Quick-action chips (mobile portrait): fill input + execute the command
    if (root) {
      root.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        const chip = target?.closest<HTMLButtonElement>(".t-qa");
        if (!chip) return;
        e.preventDefault();
        const cmd = chip.getAttribute("data-cmd");
        if (!cmd) return;
        getApi().then((api) => api.openWith(cmd));
      });
    }

    window.addEventListener("keydown", (e) => {
      const target = e.target as HTMLElement | null;
      const inEditable =
        target &&
        (target.tagName === "INPUT" ||
          target.tagName === "TEXTAREA" ||
          (target as any).isContentEditable);
      const isInsideTerm = !!target?.closest("#term");

      const isToggle =
        (e.key.toLowerCase() === "k" && (e.metaKey || e.ctrlKey)) ||
        (e.key === "`" && !inEditable);

      if (isToggle) {
        e.preventDefault();
        getApi().then((api) => api.toggle());
        return;
      }

      if (e.key === "Escape" && isInsideTerm) {
        e.preventDefault();
        getApi().then((api) => api.close());
      }
    });
  }
</script>
