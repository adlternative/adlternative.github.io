---
/**
 * Pseudo-terminal overlay.
 * - Rendered on every page (via Base.astro)
 * - Hidden by default, opens on ⌘K / Ctrl+K / backtick
 * - Disabled on screens < 640px via CSS
 * - Lazy-imports the dispatcher only on pointer:fine devices
 */
import "../styles/terminal.css";
---

<div
  id="term"
  class="term-overlay t-hidden"
  role="dialog"
  aria-modal="true"
  aria-label="adl.sh interactive terminal"
  aria-hidden="true"
>
  <div class="t-window">
    <div class="t-bar">
      <span class="t-dots">
        <span class="t-dot r"></span>
        <span class="t-dot y"></span>
        <span class="t-dot g"></span>
      </span>
      <span class="t-title-bar">zhening@adl — bash</span>
      <button type="button" class="t-close" aria-label="Close terminal (Esc)">esc</button>
    </div>
    <div class="t-screen" role="log" aria-live="polite"></div>
    <div class="t-promptline">
      <span class="t-prompt"></span>
      <input
        type="text"
        class="t-input"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="Terminal input"
        placeholder="type `help` and press Enter"
      />
    </div>
  </div>
</div>

<div class="t-hint-chip" id="term-hint" aria-hidden="true">⌘K · `</div>

<script>
  // Lazy: only desktop / fine-pointer devices boot the dispatcher.
  const HINT_KEY = "zn.term.hintseen.v1";
  const isFine =
    window.matchMedia &&
    window.matchMedia("(pointer: fine)").matches &&
    window.innerWidth >= 640;

  const root = document.getElementById("term") as HTMLElement | null;
  const hint = document.getElementById("term-hint");

  if (!isFine) {
    if (root) root.remove();
    if (hint) hint.remove();
  } else {
    // Hide hint after first open.
    let hintSeen = false;
    try {
      hintSeen = localStorage.getItem(HINT_KEY) === "1";
    } catch {
      hintSeen = false;
    }
    if (hintSeen && hint) hint.remove();

    type Api = {
      open: () => void;
      close: () => void;
      toggle: () => void;
      isOpen: () => boolean;
    };
    let apiPromise: Promise<Api> | null = null;
    function getApi(): Promise<Api> {
      if (!apiPromise) {
        apiPromise = import("../scripts/term").then(({ bootTerminal }) =>
          bootTerminal(root as HTMLElement),
        );
      }
      return apiPromise;
    }

    window.addEventListener("keydown", (e) => {
      const target = e.target as HTMLElement | null;
      // Don't hijack ⌘K when the user is mid-input in a real form field
      // outside the terminal overlay.
      const inEditable =
        target &&
        (target.tagName === "INPUT" ||
          target.tagName === "TEXTAREA" ||
          (target as any).isContentEditable);
      const isInsideTerm = !!target?.closest("#term");

      const isToggle =
        (e.key.toLowerCase() === "k" && (e.metaKey || e.ctrlKey)) ||
        (e.key === "`" && !inEditable);

      if (isToggle) {
        e.preventDefault();
        getApi().then((api) => {
          api.toggle();
          if (hint && api.isOpen()) {
            try {
              localStorage.setItem(HINT_KEY, "1");
            } catch {
              /* noop */
            }
            hint.remove();
          }
        });
        return;
      }

      if (e.key === "Escape" && isInsideTerm) {
        e.preventDefault();
        getApi().then((api) => api.close());
      }
    });
  }
</script>
